---
const path = Astro.url.pathname;
const links = [
  { href: "/#episodes", label: "节目" },
  { href: "/about", label: "关于节目" },
  { href: "https://feed.xyzfm.space/6vnv3ae7g34t", label: "RSS 订阅" },
];
---

<header class="pod-header">
  <a class="pod-skip" href="#main-content">跳到正文</a>
  <div class="pod-wrap pod-header-inner">
    <a href="/" class="pod-wordmark">轻松愉快</a>
    <span class="pod-header-note">一档中文闲聊播客</span>
    <nav class="pod-desktop-nav" aria-label="主要导航">
      {
        links.map(link => (
          <a
            href={link.href}
            aria-current={path === link.href ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <details class="pod-mobile-menu">
      <summary aria-label="展开导航">目录 <span>＋</span></summary><nav
        aria-label="手机导航"
      >
        {links.map(link => <a href={link.href}>{link.label} ↗</a>)}
      </nav>
    </details>
    <button
      id="theme-btn"
      class="pod-theme-toggle"
      aria-label="切换明暗模式"
      title="切换明暗模式">◐</button
    >
  </div>
</header>
