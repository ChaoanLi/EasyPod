---
const path = Astro.url.pathname;
const links = [
  { href: "/#episodes", label: "节目" },
  { href: "/music", label: "歌单" },
  { href: "/calendar", label: "不愉快日历" },
  { href: "/food", label: "餐厅" },
  { href: "/posts", label: "想象" },
  { href: "/about", label: "关于我们" },
];
---

<header class="pod-header">
  <a class="pod-skip" href="#main-content">跳到正文</a>
  <div class="pod-wrap pod-header-inner">
    <a href="/" class="pod-wordmark"
      >轻松愉快<span class="pod-wordmark-dot">✳</span></a
    >
    <span class="pod-header-note">生活没有标准答案，<br />我们边聊边找。</span>
    <nav class="pod-desktop-nav" aria-label="主要导航">
      {
        links.map(link => (
          <a
            href={link.href}
            aria-current={path === link.href ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <details class="pod-mobile-menu">
      <summary aria-label="展开导航">目录 <span>＋</span></summary><nav
        aria-label="手机导航"
      >
        {links.map(link => <a href={link.href}>{link.label} ↗</a>)}
      </nav>
    </details>
    <button
      id="theme-btn"
      class="pod-theme-toggle"
      aria-label="切换明暗模式"
      title="切换明暗模式">◐</button
    >
  </div>
</header>
