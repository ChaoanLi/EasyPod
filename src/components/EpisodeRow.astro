---
import type { Episode } from "@/types/podcast";
interface Props {
  episode: Episode;
  cover: string;
  index: string;
  date: string;
}
const { episode, cover, index, date } = Astro.props;
---

<article class="pod-episode-row">
  <span class="pod-episode-index">{index}</span>
  <img
    class="pod-episode-cover"
    src={cover}
    alt={`${episode.title || "轻松愉快"} · 单集封面`}
    width="96"
    height="96"
    loading="lazy"
    decoding="async"
  />
  <div class="pod-episode-info">
    <p class="pod-kicker">
      {date}{episode.itunes?.duration ? ` · ${episode.itunes.duration}` : ""}
    </p>
    <h3>
      <a href={episode.link || "#episodes"} target="_blank" rel="noreferrer"
        >{episode.title}</a>
    </h3>
  </div>
  {
    episode.enclosure?.url ? (
      <details class="pod-listen">
        <>
          <summary>
            收听 <span>＋</span>
          </summary>
          <audio controls preload="none" aria-label={`收听：${episode.title}`}>
            <source
              src={episode.enclosure.url}
              type={episode.enclosure.type || "audio/mpeg"}
            />
          </audio>
        </>
      </details>
    ) : (
      <a class="pod-simple-link" href={episode.link || "#episodes"}>
        节目详情 ↗
      </a>
    )
  }
</article>
