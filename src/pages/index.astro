---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Parser from "rss-parser";
import { SOCIALS } from "@/constants";

import type { Episode } from "@/types/podcast";
import FeaturedEpisode from "@/components/FeaturedEpisode.astro";
import EpisodeRow from "@/components/EpisodeRow.astro";
const parser = new Parser({ timeout: 20000 });
const feed = await parser.parseURL("https://feed.xyzfm.space/6vnv3ae7g34t");
const episodes: Episode[] = feed.items;
const latest = episodes[0];
const cover = latest?.itunes?.image || feed.image?.url || "/logo.png";
const dateLabel = (date?: string) => {
  const value = new Date(date || "");
  return Number.isNaN(value.getTime())
    ? ""
    : new Intl.DateTimeFormat("zh-CN", {
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
        timeZone: "Asia/Shanghai",
      }).format(value);
};
const summary = (ep: (typeof episodes)[number]) =>
  String(ep.contentSnippet || ep.itunes?.summary || "")
    .replace(/<[^>]*>/g, " ")
    .replace(/&nbsp;/g, " ")
    .replace(/\s+/g, " ")
    .trim()
    .slice(0, 120);
---

<Layout
  title="轻松愉快 — 把日子，聊成故事。"
  description="@ohaaayooo、@frank 和好朋友们的闲聊播客。聊生活、聊电影，也聊那些突然意识到的瞬间。"
>
  <Header />
  <main id="main-content" class="pod-home">
    <section class="pod-wrap pod-hero">
      <div class="pod-intro">
        <p class="pod-kicker">
          <span class="on-air-dot"></span> THE EVERYDAY, ON RECORD
        </p><h1>
          把日子，<br />聊成<span class="pod-title-stroke">故事。</span>
        </h1><p class="pod-intro-copy">
          @ohaaayooo、@frank，和好朋友们的闲聊。<br
          />聊生活，聊电影，聊那些突然意识到的瞬间。<br
          />没有标准答案，有时只是一起笑一下。
        </p><div class="pod-subscribe">
          <a
            class="pod-button"
            href="https://www.xiaoyuzhoufm.com/podcast/67c01958ef312508b9d17779"
            target="_blank"
            rel="noreferrer">在小宇宙收听 <span>↗</span></a
          ><a href="#episodes" class="pod-simple-link">全部节目 ↓</a>
        </div><div class="pod-hero-bottom">
          <span>一档中文闲聊播客</span><span>WITH FRIENDS, FOR FRIENDS.</span>
        </div>
      </div>
      {
        latest ? (
          <FeaturedEpisode
            episode={latest}
            cover={cover}
            date={dateLabel(latest.pubDate)}
            description={summary(latest)}
          />
        ) : (
          <div class="pod-no-episodes">
            <>
              <h2>下一次对话，正在路上。</h2>
              <a href="https://feed.xyzfm.space/6vnv3ae7g34t">
                订阅节目 RSS ↗
              </a>
            </>
          </div>
        )
      }
    </section>
    <section id="episodes" class="pod-wrap pod-episodes">
      <div class="pod-section-heading">
        <div>
          <p class="pod-kicker">THE CONVERSATION ARCHIVE</p><h2>
            慢慢听，不着急<span>。</span>
          </h2>
        </div><span class="pod-episode-count"
          >{episodes.length} 期对话 / 持续收录</span
        >
      </div>
      <div class="pod-episode-list">
        {
          episodes.map((ep, index) => (
            <EpisodeRow
              episode={ep}
              index={String(episodes.length - index).padStart(2, "0")}
              date={dateLabel(ep.pubDate)}
            />
          ))
        }
      </div>
    </section>
    <section class="pod-wrap pod-platforms">
      <p class="pod-kicker">选一个你习惯的地方，我们在那里见。</p><div>
        {
          SOCIALS.filter(s => s.name !== "Mail").map(s => (
            <a href={s.href} target="_blank" rel="noreferrer">
              {s.name}
              <span>↗</span>
            </a>
          ))
        }
      </div>
    </section>
  </main>
  <Footer />
</Layout>
<script>
  // Only one conversation plays at a time, including the featured episode.
  document.addEventListener(
    "play",
    event => {
      if (!(event.target instanceof HTMLAudioElement)) return;
      const current = event.target;
      document.querySelectorAll("audio").forEach(audio => {
        if (audio !== current) audio.pause();
      });
    },
    true
  );
</script>
