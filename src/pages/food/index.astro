---
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
---

<Layout title="餐厅安利 | 轻松愉快"
  ><Header /><Main
    pageTitle="好好吃饭。"
    pageDesc="主播和朋友们的美食地图。把好吃的地方记下来，下次再一起去。"
    ><div class="pod-food-grid">
      <a
        class="pod-map-link"
        href="https://maps.app.goo.gl/ZaLTKN6CqdmwKLpCA?g_st=ac"
        target="_blank"
        rel="noreferrer"
        ><span class="pod-map-symbol">◎</span><span class="pod-kicker"
          >AROUND THE WORLD</span
        ><h2>在世界的某个角落</h2><p>
          出门在外，也想找到一顿让人开心的饭。
        </p><span>打开 Google 地图 ↗</span></a
      ><a
        class="pod-map-link"
        href="https://mmapgwh.map.qq.com/shortlink/short?l=_1b65052e4ac151b516b54112589d5363"
        target="_blank"
        rel="noreferrer"
        ><span class="pod-map-symbol">◡</span><span class="pod-kicker"
          >CLOSER TO HOME</span
        ><h2>熟悉的街头巷尾</h2><p>在国内，跟着朋友们的安利慢慢找。</p><span
          >打开腾讯地图 ↗</span
        ></a>
    </div></Main
  ><Footer /></Layout
>
