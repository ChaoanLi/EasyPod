---
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
---

<Layout title="轻松歌单 | 轻松愉快">
  <Header />
  <Main
    pageTitle="轻松歌单"
    pageDesc="主播和朋友们喜欢的歌。有时循环播放，有时听到一句就想起一个人。"
  >
    <div class="pod-music-player not-prose">
      <meting-js
        server="netease"
        type="playlist"
        id="13628828948"
        theme="#8a9870"
        autoplay="false"
        order="list"
        loop="all"
        preload="none"
        list-folded="false"
        list-max-height="400px"></meting-js>
    </div>
    <p>也可以在你习惯的音乐 App 里收听。</p>
    <div class="pod-music-links">
      <a
        href="https://music.163.com/#/playlist?id=13628828948"
        target="_blank"
        rel="noreferrer">网易云音乐 ↗</a
      ><a
        href="https://music.apple.com/cn/playlist/轻松愉快/pl.u-d2b05gWCblzYJr"
        target="_blank"
        rel="noreferrer">Apple Music ↗</a>
    </div>
  </Main>
  <Footer />
  <link
    rel="stylesheet"
    href="https://unpkg.com/aplayer/dist/APlayer.min.css"
  />
  <script src="https://unpkg.com/aplayer/dist/APlayer.min.js" defer is:inline
  ></script>
  <script src="https://unpkg.com/meting/dist/Meting.min.js" defer is:inline
  ></script>
</Layout>
